# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Neon Postgres connection string (create a project at https://neon.tech,
# copy the pooled connection string). Required for any page that reads
# categories/entries — without it the site still runs but shows empty states.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth credentials, from Google Cloud Console. Create a Web
# application OAuth 2.0 Client ID with redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-production-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated Google account emails granted admin access to /admin.
# Checked on every sign-in (src/auth.ts) — everyone else gets role: viewer.
ADMIN_EMAILS=""

# Shared secret the autonomous pipeline routine sends when calling
# /api/pipeline/ingest (Phase 3). Generate any long random string.
CRON_SECRET=""

# Used to build absolute URLs (share links, OG images). Set to the real
# domain once deployed; defaults to modinekiyakyahai.com otherwise.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Anthropic API key (Phase 3 — pipeline drafting/moderation classification).
ANTHROPIC_API_KEY=""

# Google AdSense publisher ID (e.g. "ca-pub-1234567890123456"), from an
# approved AdSense account at adsense.google.com. The consent banner
# (src/components/ConsentBanner.tsx) is already wired up; the actual
# AdSense script + ad slots get added once this is set — not before,
# since a fake ID would just fail to load.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
